{
  "name": "clorinda-frontend",
  "version": "0.0.0",
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,html,css,scss,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,html,css,scss,json,md}\"",
    "type-check": "tsc --noEmit -p tsconfig.app.json",
    "validate": "npm run type-check && npm run lint && npm run format:check && npm run test",
    "serve:ssr:clorinda-frontend": "node dist/clorinda-frontend/server/server.mjs",
    "prepare": "husky"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "21.2.14",
    "@angular/common": "21.2.14",
    "@angular/compiler": "21.2.14",
    "@angular/core": "21.2.14",
    "@angular/forms": "21.2.14",
    "@angular/platform-browser": "21.2.14",
    "@angular/platform-server": "21.2.14",
    "@angular/router": "21.2.14",
    "@angular/ssr": "21.2.12",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "chart.js": "^4.5.1",
    "express": "^5.2.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "21.2.12",
    "@angular-eslint/builder": "^21.4.0",
    "@angular/build": "21.2.12",
    "@angular/cli": "21.2.12",
    "@angular/compiler-cli": "21.2.14",
    "@angular/localize": "21.2.14",
    "@angular/platform-browser-dynamic": "21.2.14",
    "@angular/service-worker": "21.2.14",
    "@eslint/js": "^10.0.1",
    "@ng-bootstrap/ng-bootstrap": "^20.0.0",
    "@types/express": "^5.0.6",
    "@types/jasmine": "^6.0.0",
    "@types/node": "^25.9.1",
    "angular-eslint": "^21.4.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jasmine-core": "^6.2.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.2.0",
    "lint-staged": "^15.4.3",
    "prettier": "^3.8.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.4",
    "zone.js": "^0.16.2"
  },
  "lint-staged": {
    "*.{ts,html,css,scss,json,md}": "prettier --write",
    "*.ts": "eslint --fix"
  }
}
